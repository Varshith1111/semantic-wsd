# Application Configuration
APP_NAME=SemanticWSD
APP_VERSION=1.0.0
DEBUG=true

# Database
DATABASE_URL=sqlite:///./semantic_wsd.db

# Model Configuration
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# Scoring Weights
FIRST_ORDER_WEIGHT=0.6
SECOND_ORDER_WEIGHT=0.4

# Server
HOST=0.0.0.0
PORT=8000

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
